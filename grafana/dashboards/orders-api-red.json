{
  "uid": "orders-red",
  "title": "Orders API - RED + Business",
  "tags": [
    "lab",
    "orders",
    "red"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(http_server_requests_seconds_count, namespace)",
        "refresh": 2,
        "includeAll": false,
        "current": {
          "text": "apps",
          "value": "apps"
        }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(http_server_requests_seconds_count{namespace=\"$namespace\"}, pod)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "RED - Rate / Errors / Duration",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Requetes / s",
      "description": "Le R de RED. rate() sur un counter, jamais la valeur brute.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "rps"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Taux d'erreur 5xx",
      "description": "Seules les 5xx comptent. Les 4xx sont des fautes du client et ne doivent pas consommer le budget d'erreur.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "(sum(rate(http_server_requests_seconds_count{namespace=\"$namespace\", pod=~\"$pod\", status=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": "erreurs"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Latence p95",
      "description": "histogram_quantile APRES avoir somme les buckets par le. L'inverse donne un resultat faux.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "SLO 300ms (part des requetes sous 300ms)",
      "description": "Utilise le bucket exact le=0.3 declare via serviceLevelObjectives dans ObservabilityConfig. Pas d'interpolation, donc chiffre exact.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "(sum(rate(http_server_requests_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\", le=\"0.3\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))) or vector(1)",
          "legendFormat": "sous 300ms"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Trafic par endpoint (uri = TEMPLATE, pas l'URL reelle)",
      "description": "Le label uri vaut /api/orders/{id}. S'il contenait l'ID reel, chaque commande creerait une serie temporelle : c'est l'explosion de cardinalite numero 1 en production.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (uri, method) (rate(http_server_requests_seconds_count{namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Latence p50 / p95 / p99",
      "description": "Toujours afficher plusieurs quantiles ensemble. Un p50 stable avec un p99 qui explose signale une contention, du GC ou de la file d'attente, pas une surcharge globale.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Reponses par code HTTP",
      "description": "2xx / 4xx / 5xx cote a cote : le panel qui prouve qu'on a bien separe faute client et faute serveur.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 40,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}"
        }
      ],
      "id": 8
    },
    {
      "type": "row",
      "title": "Metriques metier (ce qui interesse vraiment le business)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Chiffre d'affaires encaisse (EUR/min)",
      "description": "increase() sur un counter d'euros. Un dashboard qui parle argent est celui que le sponsor du projet regardera. C'est ce qui fait acheter la plateforme.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "custom": {
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(increase(orders_revenue_euros_total{namespace=\"$namespace\"}[1m]))",
          "legendFormat": "CA par minute"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Motifs de refus de paiement",
      "description": "Label reason a cardinalite bornee (4 valeurs). Un pic sur fraud_suspected est une information metier, pas une panne technique.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (reason) (rate(orders_payments_declined_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Commandes par statut (gauge)",
      "description": "Gauge : on lit la valeur telle quelle, sans rate(). Une pile de PENDING qui grossit signale un blocage en aval.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (status) (orders_in_status{namespace=\"$namespace\"})",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 12
    },
    {
      "type": "logs",
      "title": "Logs correles (memes labels namespace/pod que les metriques)",
      "description": "Ce panel utilise EXACTEMENT les memes labels que les metriques ci-dessus. C'est cette convention de nommage, imposee dans la config Alloy, qui rend la correlation possible.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "{namespace=\"$namespace\", app=\"orders-api\"} | json | level =~ \"WARN|ERROR\"",
          "queryType": "range"
        }
      ],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "JVM - heap utilise vs memoire du conteneur",
      "description": "Superposer le heap JVM et le working set du conteneur. Un ecart croissant revele une consommation hors-heap (metaspace, buffers directs, threads) que -Xmx ne protege pas.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (pod) (jvm_memory_used_bytes{namespace=\"$namespace\", area=\"heap\"})",
          "legendFormat": "heap {{pod}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", container=\"orders-api\"})",
          "legendFormat": "conteneur {{pod}}"
        }
      ],
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "JVM - temps passe en GC",
      "description": "Des pauses GC longues expliquent souvent un p99 degrade alors que le p50 reste bon. Toujours regarder ce panel avant d'incriminer le reseau.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (pod) (rate(jvm_gc_pause_seconds_sum{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "temps GC par seconde {{pod}}"
        }
      ],
      "id": 15
    }
  ]
}