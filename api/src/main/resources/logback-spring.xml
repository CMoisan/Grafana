<?xml version="1.0" encoding="UTF-8"?>
<!--
  ===========================================================================
  LOGS STRUCTURES JSON - la configuration qui rend Loki reellement utilisable
  ===========================================================================
  Deux profils :
   - `local`  : logs texte colorises, lisibles par un humain dans l'IDE.
   - defaut   : logs JSON une-ligne, destines a Alloy -> Loki.

  POURQUOI DU JSON ?
  Un log texte "Order 42 paid in 120ms" oblige a ecrire une regexp fragile dans
  LogQL. Le meme log en JSON donne des champs exploitables immediatement :
      {app="orders-api"} | json | level="ERROR" | duration_ms > 500
  Vous passez de "je cherche du texte" a "j'interroge des donnees".

  POURQUOI ECRIRE SUR STDOUT ?
  Regle des 12-factor apps : une application ne gere JAMAIS ses fichiers de log.
  Elle ecrit sur stdout, le conteneur redirige vers /var/log/pods/..., et
  l'agent (Alloy) collecte. Ecrire dans un fichier dans un conteneur = logs
  perdus au redemarrage + disque plein + rotation a gerer soi-meme.
  ===========================================================================
-->
<configuration>

    <!-- Recupere le nom d'appli defini dans application.yaml -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="orders-api"/>
    <springProperty scope="context" name="appEnv" source="app.environment" defaultValue="dev"/>

    <!-- ===================== PROFIL LOCAL : texte lisible ===================== -->
    <springProfile name="local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <!--
                  %X{traceId} lit le MDC (Mapped Diagnostic Context).
                  Micrometer Tracing y place automatiquement traceId et spanId
                  pour chaque requete HTTP. C'est gratuit et ca change la vie.
                -->
                <pattern>%d{HH:mm:ss.SSS} %-5level [%X{traceId:-},%X{spanId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ================= PROFIL PAR DEFAUT (k8s) : JSON ==================== -->
    <springProfile name="!local">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <!-- Horodatage ISO-8601 : Loki s'en sert si on configure un
                         `timestamp` stage cote Alloy ; sinon Loki utilise l'heure
                         d'ingestion. Toujours emettre l'heure de l'EVENEMENT. -->
                    <timestamp>
                        <timeZone>UTC</timeZone>
                        <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</pattern>
                    </timestamp>
                    <logLevel/>
                    <loggerName>
                        <shortenedLoggerNameLength>40</shortenedLoggerNameLength>
                    </loggerName>
                    <threadName/>
                    <message/>

                    <!-- Champs constants : deviendront des filtres dans Loki -->
                    <pattern>
                        <pattern>
                            {
                              "app": "${appName}",
                              "env": "${appEnv}",
                              "traceId": "%mdc{traceId:-}",
                              "spanId": "%mdc{spanId:-}"
                            }
                        </pattern>
                    </pattern>

                    <!-- Tout le MDC : permet d'enrichir un log depuis le code via
                         MDC.put("orderId", id) sans changer cette config. -->
                    <mdc/>

                    <!-- Stack traces compactees : sans ca une exception Spring
                         fait 200 lignes et sature votre quota d'ingestion Loki.
                         maxDepthPerThrowable + exclude = -80% de volume. -->
                    <stackTrace>
                        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                            <maxDepthPerThrowable>25</maxDepthPerThrowable>
                            <maxLength>4096</maxLength>
                            <shortenedClassNameLength>30</shortenedClassNameLength>
                            <exclude>^sun\.reflect\..*\.invoke</exclude>
                            <exclude>^net\.sf\.cglib\.proxy\.MethodProxy\.invoke</exclude>
                            <exclude>^org\.apache\.catalina\..*</exclude>
                            <exclude>^org\.springframework\.web\.filter\..*</exclude>
                            <rootCauseFirst>true</rootCauseFirst>
                        </throwableConverter>
                    </stackTrace>
                </providers>
            </encoder>
        </appender>

        <!--
          ASYNC : le logging devient non bloquant.
          Sous forte charge k6, un appender synchrone bloque les threads Tomcat
          sur des ecritures stdout et FAUSSE completement vos mesures de latence.
          neverBlock=true : on prefere PERDRE des logs plutot que ralentir le
          service. C'est un choix explicite, a assumer et a savoir defendre.
        -->
        <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>8192</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
            <appender-ref ref="JSON"/>
        </appender>

        <root level="INFO">
            <appender-ref ref="ASYNC_JSON"/>
        </root>
    </springProfile>

</configuration>
